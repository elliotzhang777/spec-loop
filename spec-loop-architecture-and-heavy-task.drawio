        </mxCell>
        <mxCell id="ah" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;Agent CLI&lt;/b&gt;&lt;br&gt;主控会话 + 隔离 Maker/Verifier 会话" vertex="1">
          <mxGeometry height="50" width="580" x="475" y="115" as="geometry" />
