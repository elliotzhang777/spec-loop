        <mxCell id="repo" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=8;" value="&lt;b&gt;目标工程 Git / spec/&lt;/b&gt;&lt;br&gt;代码、长期产品与技术规格&lt;br&gt;唯一代码事实源" vertex="1">
