          <mxGeometry height="110" width="460" x="535" y="190" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" value="&lt;b&gt;建立受控 Task&lt;/b&gt;&lt;br&gt;Proposal/Approval（如需要）&lt;br&gt;init heavy → validate → plan&lt;br&gt;draft → planned；冻结 Acceptance hash" vertex="1">
          <mxGeometry height="125" width="360" x="1160" y="185" as="geometry" />
        </mxCell>
        <mxCell id="h2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;spacing=10;" value="&lt;b&gt;批准启动 / 继续&lt;/b&gt;&lt;br&gt;这里只授权实现与 feedback，不等于正式交付" vertex="1">
          <mxGeometry height="92" width="300" x="85" y="365" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=14;spacing=10;" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;ROLE · CONTROLLER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;编排本轮动作，不直接实现&lt;/b&gt;&lt;br&gt;调用 round / workspace / harness prepare；给 Maker 最小批准步骤" vertex="1">
          <mxGeometry height="100" width="460" x="513" y="357" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" value="&lt;b&gt;Round + Workspace&lt;/b&gt;&lt;br&gt;planned/iterating → working&lt;br&gt;创建或恢复 worktree，绑定 base/branch/HEAD&lt;br&gt;Harness prepare 校验权限和计划" vertex="1">
          <mxGeometry height="125" width="360" x="1160" y="345" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=14;spacing=10;" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;ROLE · MAKER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;独立 Agent CLI invocation&lt;/b&gt;&lt;br&gt;在 Task worktree 实现、修复、补测试；不能改 Approval / AC / Gate Plan" vertex="1">
          <mxGeometry height="115" width="460" x="535" y="525" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" value="&lt;b&gt;Harness execute / collect&lt;/b&gt;&lt;br&gt;调用 Provider；重新读取 Git HEAD/diff/touched files&lt;br&gt;追加 Attempt / Execution Event；不信任 Agent 自报" vertex="1">
          <mxGeometry height="125" width="360" x="1160" y="515" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" value="&lt;b&gt;快速反馈检查&lt;/b&gt;&lt;br&gt;定向编译 / 测试 / smoke / 页面预览&lt;br&gt;只用于反馈，不能签署 Delivery Evidence" vertex="1">
          <mxGeometry height="110" width="360" x="1160" y="690" as="geometry" />
        </mxCell>
        <mxCell id="a4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=14;spacing=10;" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;ROLE · CONTROLLER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;解释候选并收集反馈&lt;/b&gt;&lt;br&gt;总结改动、风险、预览入口；不把定向检查冒充正式 Evidence" vertex="1">
          <mxGeometry height="95" width="460" x="535" y="695" as="geometry" />
        </mxCell>
        <mxCell id="h3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;spacing=10;" value="&lt;b&gt;查看候选并反馈&lt;/b&gt;&lt;br&gt;不满意：继续修改；满意：形成稳定 revision" vertex="1">
          <mxGeometry height="90" width="300" x="85" y="700" as="geometry" />
        </mxCell>
        <mxCell id="d-feedback" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" value="满意？" vertex="1">
          <mxGeometry height="85" width="120" x="175" y="840" as="geometry" />
        </mxCell>
        <mxCell id="h4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;spacing=10;" value="&lt;b&gt;明确授权正式验证&lt;/b&gt;&lt;br&gt;授权只绑定当前稳定候选；候选变化立即失效" vertex="1">
          <mxGeometry height="95" width="300" x="85" y="985" as="geometry" />
        </mxCell>
        <mxCell id="a5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=14;spacing=10;" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;ROLE · GATE PLANNER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;冻结候选与 Gate Plan（不得由 Maker 自定）&lt;/b&gt;&lt;br&gt;确认影响范围、coverage、数据库 lifecycle；提交 Spec-Loop 执行" vertex="1">
          <mxGeometry height="105" width="460" x="535" y="975" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" value="&lt;b&gt;正式确定性 Gate&lt;/b&gt;&lt;br&gt;构建 / 单元 / 集成 / Playwright / 安全检查&lt;br&gt;Heavy 可用 full；绑定当前 HEAD、耗时和 artifact hash" vertex="1">
          <mxGeometry height="125" width="360" x="1160" y="965" as="geometry" />
        </mxCell>
        <mxCell id="d-gate" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" value="Gate PASS？" vertex="1">
          <mxGeometry height="90" width="140" x="1270" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="a6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=14;spacing=10;" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;ROLE · VERIFIER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;新的只读 Agent CLI invocation&lt;/b&gt;&lt;br&gt;读取 AC / diff / Gate / Evidence；检查遗漏、越权、伪通过，输出 PASS/FAIL" vertex="1">
          <mxGeometry height="120" width="460" x="535" y="1275" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" value="&lt;b&gt;校验 Verifier 与 Review 绑定&lt;/b&gt;&lt;br&gt;独立性、当前 Round/revision、Evidence hash&lt;br&gt;UI AC 还要求当前截图的 Visual Review" vertex="1">
          <mxGeometry height="120" width="360" x="1160" y="1275" as="geometry" />
        </mxCell>
        <mxCell id="d-verifier" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;" value="Verifier PASS？" vertex="1">
          <mxGeometry height="90" width="145" x="695" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="h5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;spacing=10;" value="&lt;b&gt;人工检查 / Heavy Acceptance&lt;/b&gt;&lt;br&gt;UI 时检查截图效果；确认当前 revision 是否可接受" vertex="1">
          <mxGeometry height="105" width="300" x="85" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="d-human" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" value="接受？" vertex="1">
          <mxGeometry height="85" width="120" x="175" y="1720" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" value="&lt;b&gt;Task verify --pass&lt;/b&gt;&lt;br&gt;working → verifying&lt;br&gt;把 Gate、独立 Verifier、Human/Visual Review 写入当前 Evidence" vertex="1">
          <mxGeometry height="110" width="360" x="1160" y="1580" as="geometry" />
        </mxCell>
        <mxCell id="s8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=10;" value="&lt;b&gt;Delivery Guard + deliver&lt;/b&gt;&lt;br&gt;逐项验证 AC → 当前 Round Evidence&lt;br&gt;verifying → delivered；生成可重建交付结论" vertex="1">
          <mxGeometry height="115" width="360" x="1160" y="1800" as="geometry" />
        </mxCell>
        <mxCell id="h6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=10;" value="&lt;b&gt;收到交付结果&lt;/b&gt;&lt;br&gt;是否 merge / push / deploy 仍需另行授权" vertex="1">
          <mxGeometry height="90" width="300" x="85" y="1975" as="geometry" />
        </mxCell>
        <mxCell id="s-fail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=10;" value="&lt;b&gt;失败统一收口&lt;/b&gt;&lt;br&gt;记录失败 Evidence / Attempt&lt;br&gt;verify --fail → iterating&lt;br&gt;Guard：continue / needs_user / stop" vertex="1">
          <mxGeometry height="120" width="360" x="1160" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="a-fix" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=10;" value="&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;ROLE · CONTROLLER / TRIAGE AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;依据失败事实分类，不亲自覆盖结论&lt;/b&gt;&lt;br&gt;repair / replan / provider retry / 找人；Guard=continue 才能下一 Round" vertex="1">
          <mxGeometry height="105" width="460" x="535" y="1830" as="geometry" />
        </mxCell>
