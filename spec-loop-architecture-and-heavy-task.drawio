        <mxCell id="control-data" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=8;" value="&lt;b&gt;.spec-loop/ 控制事实&lt;/b&gt;&lt;br&gt;Task State · History · Ledger · Approval&lt;br&gt;Harness · Evidence · Review · Delivery · Events" vertex="1">
          <mxGeometry height="120" width="360" x="900" y="925" as="geometry" />
        </mxCell>
