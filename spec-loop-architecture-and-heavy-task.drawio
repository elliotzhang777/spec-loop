        </mxCell>
        <mxCell id="human-head" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;人&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7f6000&quot;&gt;目标、授权、反馈、主观判断、最终责任&lt;/font&gt;" vertex="1">
          <mxGeometry height="58" width="260" x="60" y="115" as="geometry" />
        </mxCell>
        <mxCell id="agent-head" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;Agent CLI&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#674ea7&quot;&gt;同一种技术执行者，以隔离会话承担不同工作模式&lt;/font&gt;" vertex="1">
          <mxGeometry height="58" width="460" x="390" y="115" as="geometry" />
        </mxCell>
        <mxCell id="sl-head" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;Spec-Loop&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2f5597&quot;&gt;确定性控制、状态与门禁；当前不是常驻自动 Controller&lt;/font&gt;" vertex="1">
          <mxGeometry height="58" width="640" x="920" y="115" as="geometry" />
        </mxCell>
        <mxCell id="human-goal" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;spacing=10;" value="&lt;b&gt;1. 提出目标 / 需求&lt;/b&gt;&lt;br&gt;批准范围、风险与开始执行" vertex="1">
          <mxGeometry height="80" width="240" x="70" y="200" as="geometry" />
        </mxCell>
        <mxCell id="human-feedback" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;spacing=10;" value="&lt;b&gt;2. 看预览并反馈&lt;/b&gt;&lt;br&gt;功能意见 / 视觉 Review / needs_user" vertex="1">
          <mxGeometry height="90" width="240" x="70" y="355" as="geometry" />
        </mxCell>
        <mxCell id="human-auth" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;spacing=10;" value="&lt;b&gt;3. 明确升级授权&lt;/b&gt;&lt;br&gt;进入正式验证 / 完整 Gate" vertex="1">
          <mxGeometry height="85" width="240" x="70" y="520" as="geometry" />
        </mxCell>
        <mxCell id="human-heavy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;spacing=10;" value="&lt;b&gt;4. Heavy 最终验收&lt;/b&gt;&lt;br&gt;接受或拒绝当前 revision" vertex="1">
          <mxGeometry height="85" width="240" x="70" y="675" as="geometry" />
        </mxCell>
        <mxCell id="agent-main" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=14;spacing=10;" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;ROLE · CONTROLLER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;主控 Agent 会话（当前兼任 Analyst / Planner）&lt;/b&gt;&lt;br&gt;理解意图、选择下一命令、组织反馈；不写 Gate PASS&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Heavy 目标态应拆出独立 Analyst / Planner / Plan Reviewer&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="430" x="405" y="190" as="geometry" />
        </mxCell>
        <mxCell id="agent-maker" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=14;spacing=10;" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;ROLE · MAKER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;独立 Agent CLI invocation&lt;/b&gt;&lt;br&gt;只在批准的 worktree 修改代码和测试&lt;br&gt;不改 AC / Gate Plan，不验证自己" vertex="1">
          <mxGeometry height="100" width="430" x="405" y="375" as="geometry" />
        </mxCell>
        <mxCell id="agent-checker" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=14;spacing=10;" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;ROLE · VERIFIER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;新的隔离 Agent CLI invocation&lt;/b&gt;&lt;br&gt;读取 Spec / AC / diff / Evidence，主动找遗漏和越权&lt;br&gt;与 Maker 不共享上下文，默认只读、不修复" vertex="1">
          <mxGeometry height="100" width="430" x="405" y="575" as="geometry" />
        </mxCell>
        <mxCell id="agent-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=13;spacing=10;" value="&lt;b&gt;Maker / Verifier 不是新的人或新系统&lt;/b&gt;&lt;br&gt;它们只是 Agent CLI 的两次隔离执行模式。" vertex="1">
          <mxGeometry height="75" width="350" x="445" y="710" as="geometry" />
        </mxCell>
        <mxCell id="sl-cli" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" value="&lt;b&gt;CLI / Provider Adapter&lt;/b&gt;&lt;br&gt;严格命令输入、Schema、权限和路径边界" vertex="1">
          <mxGeometry height="90" width="285" x="930" y="190" as="geometry" />
        </mxCell>
        <mxCell id="sl-policy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" value="&lt;b&gt;确定性控制规则&lt;/b&gt;&lt;br&gt;Proposal/Approval · Spec/AC hash&lt;br&gt;Task 状态机 · Budget/Guard · Delivery Guard" vertex="1">
          <mxGeometry height="105" width="300" x="1240" y="190" as="geometry" />
        </mxCell>
        <mxCell id="sl-harness" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" value="&lt;b&gt;Worktree + Harness&lt;/b&gt;&lt;br&gt;prepare → execute → collect → verify → report&lt;br&gt;负责调用 Maker，并核对真实 Git HEAD/diff" vertex="1">
          <mxGeometry height="115" width="285" x="930" y="350" as="geometry" />
        </mxCell>
        <mxCell id="sl-gate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" value="&lt;b&gt;确定性 Gate（Spec-Loop 自己执行）&lt;/b&gt;&lt;br&gt;构建 / 测试 / Playwright / timeout&lt;br&gt;产生 exit code、duration、artifact hash" vertex="1">
          <mxGeometry height="115" width="300" x="1240" y="350" as="geometry" />
        </mxCell>
        <mxCell id="sl-verifier-dispatch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" value="&lt;b&gt;Verifier 调度与签署校验&lt;/b&gt;&lt;br&gt;要求独立上下文；Heavy 还要求 human check&lt;br&gt;Spec-Loop 验证证据，不替 Verifier 做语义判断" vertex="1">
          <mxGeometry height="115" width="285" x="930" y="540" as="geometry" />
        </mxCell>
        <mxCell id="sl-review-delivery" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" value="&lt;b&gt;Review + Evidence + Delivery&lt;/b&gt;&lt;br&gt;绑定 Task / Round / revision / hash&lt;br&gt;AC → Evidence 映射后才允许 delivered" vertex="1">
          <mxGeometry height="115" width="300" x="1240" y="540" as="geometry" />
        </mxCell>
        <mxCell id="sl-view" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" value="&lt;b&gt;执行观测面（预览）&lt;/b&gt;&lt;br&gt;EXECUTION_EVENTS → snapshot → 本地只读网页&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;只有经过新版 CLI 的步骤才有实时事件&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="390" x="1040" y="700" as="geometry" />
        </mxCell>
        <mxCell id="data-plane" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=6;" value="" vertex="1">
