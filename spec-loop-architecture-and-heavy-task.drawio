  <diagram id="simplification-review" name="03 不合理点与去留建议">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rt" value="&lt;b&gt;Spec-Loop 去留审视&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;原则：责任要保留，伪角色、重名流程、重复状态和重复产物应删除或合并&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1540" height="60" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;红：建议删除/改名&lt;/b&gt;&lt;/font&gt;　 &lt;font color=&quot;#b45f06&quot;&gt;&lt;b&gt;黄：建议合并/收敛&lt;/b&gt;&lt;/font&gt;　 &lt;font color=&quot;#38761d&quot;&gt;&lt;b&gt;绿：建议保留&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="45" y="82" width="900" height="35" as="geometry" />
        </mxCell>
        <mxCell id="red-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="500" height="865" as="geometry" />
        </mxCell>
        <mxCell id="yellow-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d79b00;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="575" y="135" width="500" height="865" as="geometry" />
        </mxCell>
        <mxCell id="green-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3fbf3;strokeColor=#82b366;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="1110" y="135" width="470" height="865" as="geometry" />
        </mxCell>
        <mxCell id="rh" value="&lt;b&gt;建议删除 / 改名&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;会误导“谁真正执行”或造成假实时&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="65" y="150" width="450" height="55" as="geometry" />
        </mxCell>
        <mxCell id="yh" value="&lt;b&gt;建议合并 / 收敛&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#b45f06&quot;&gt;责任合理，但模型层次过多、事实重复&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="450" height="55" as="geometry" />
        </mxCell>
        <mxCell id="gh" value="&lt;b&gt;建议保留&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#38761d&quot;&gt;这些边界真正降低了自证、越权和不可恢复风险&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1135" y="150" width="420" height="55" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;R1｜删除“Controller 是第四个执行者”的画法&lt;/b&gt;&lt;br&gt;现状：文档说 Controller 在 Spec-Loop 内；Phase 3 实际是主控 Agent CLI 做决策，Spec-Loop 只执行确定性命令。&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;建议：Phase 3 明写“Agent 主控 + Spec-Loop Guard”；等 Phase 4 常驻 Controller 真落地后再改。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="70" y="225" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;R2｜Maker / Gate / Verifier / Guard 不应并列成四个“角色”&lt;/b&gt;&lt;br&gt;Maker、Verifier 是 Agent CLI 的隔离执行模式；Gate 是 Spec-Loop 操作；Guard 是 Spec-Loop 策略。&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;建议：保留职责，删除拟人化角色层。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="70" y="395" width="440" height="135" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;R3｜解决两个 verify 重名&lt;/b&gt;&lt;br&gt;`harness verify` 实际是运行 Gate；`task verify` 是签署 Round Evidence 并迁移状态。&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;建议：前者改为 gate-run，后者改为 accept-round / sign-round。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="70" y="555" width="440" height="125" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;R4｜删除“网页天然实时”的暗示&lt;/b&gt;&lt;br&gt;当前只有通过新版 Spec-Loop CLI 的步骤会写 Execution Events；既有主控 Agent/旧进程不会自动接入。&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;建议：Agent CLI 强制走 wrapper/callback 前，只称“事实重建视图”，不能称完整实时引擎监控。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="70" y="705" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="&lt;b&gt;R5｜直接来自人的任务，不必强制再走 Proposal → Approval&lt;/b&gt;&lt;br&gt;人已经在当前会话明确提出并授权时，再制造一份建议和批准容易成为仪式。&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;建议：Proposal 只保留给自动发现、外部来源和异步建议。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="70" y="880" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="y1" value="&lt;b&gt;Y1｜Round / Attempt / Harness Run 三套执行身份&lt;/b&gt;&lt;br&gt;三者分别有价值，但现在关联依赖 task_id + round + run_id + 时间推断。&lt;br&gt;&lt;font color=&quot;#b45f06&quot;&gt;建议：统一为 Execution Run；Round 是业务迭代号，Attempt/Harness Step 都是 Run 子记录。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="605" y="225" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="y2" value="&lt;b&gt;Y2｜四级 verification stage 与 Task 状态机并存&lt;/b&gt;&lt;br&gt;feedback / candidate / delivery / phase 不是 Task 状态，却常被写成流程阶段；candidate 还没有明确持久事实。&lt;br&gt;&lt;font color=&quot;#b45f06&quot;&gt;建议：改成 Verification Intent 枚举，只影响 Gate Plan，不进入主生命周期。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="605" y="395" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="y3" value="&lt;b&gt;Y3｜Evidence 多次复制同一事实&lt;/b&gt;&lt;br&gt;Gate JSON、artifact、Harness Report、VERIFY Evidence、Delivery mapping 都可能重复 HEAD/AC/hash/结论。&lt;br&gt;&lt;font color=&quot;#b45f06&quot;&gt;建议：保留一份原子 Evidence Record；Report、VERIFY、Delivery 都改为引用或可重建投影。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="605" y="565" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="y4" value="&lt;b&gt;Y4｜人类门禁数量需要按 revision 合并呈现&lt;/b&gt;&lt;br&gt;启动批准、正式验证授权、Visual Review、Heavy Acceptance、阶段验收各有不同语义，但 UI 分散会造成“连续点批准”。&lt;br&gt;&lt;font color=&quot;#b45f06&quot;&gt;建议：底层仍分开审计，界面按当前 revision 聚合为一次决策清单。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="605" y="735" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="y5" value="&lt;b&gt;Y5｜Project State 与 Task 派生摘要继续收缩&lt;/b&gt;&lt;br&gt;current_goal/next_action 和 Task 当前状态容易出现两套叙事。&lt;br&gt;&lt;font color=&quot;#b45f06&quot;&gt;建议：Project 只保存用户级目标和候选；active task、进度、下一动作全部从 Task/Event 派生。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="605" y="905" width="440" height="75" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="&lt;b&gt;G1｜人保留最终权力&lt;/b&gt;&lt;br&gt;范围变化、高风险授权、主观视觉判断、Heavy 最终接受不能交给模型自签。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1140" y="225" width="410" height="105" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="&lt;b&gt;G2｜确定性 Gate 与语义 Verifier 分离&lt;/b&gt;&lt;br&gt;机器可重复检查负责事实；隔离 Agent CLI 负责规格遗漏和越权审查。两者不能互相替代。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1140" y="355" width="410" height="115" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="&lt;b&gt;G3｜Worktree 隔离&lt;/b&gt;&lt;br&gt;Agent CLI 不直接污染主工作区；Spec-Loop collect 重新读取真实 Git HEAD 和 diff。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1140" y="495" width="410" height="100" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="&lt;b&gt;G4｜AC / Evidence / revision / hash 绑定&lt;/b&gt;&lt;br&gt;防止用旧截图、旧 Gate 或 Agent 自述冒充当前候选已经通过。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1140" y="620" width="410" height="100" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="&lt;b&gt;G5｜状态机 + 可恢复写入&lt;/b&gt;&lt;br&gt;draft → planned → working → verifying/iterating → delivered，以及事务恢复、reconcile 和 fail closed。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1140" y="745" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="&lt;b&gt;G6｜等待与主动耗时分开&lt;/b&gt;&lt;br&gt;对优化引擎非常关键：不要把等待用户、Visual Review 和授权时间算成 Agent 主动执行时间。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1140" y="880" width="410" height="100" as="geometry" />
        </mxCell>
        <mxCell id="bottom" value="&lt;b&gt;建议的最简心智模型&lt;/b&gt;　人决定“做什么 / 是否接受”　→　Agent CLI 决定“怎么分析与修改”　→　Spec-Loop 决定“什么操作被允许、事实如何记录、证据是否足够”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#5b9bd5;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="180" y="1030" width="1270" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="agent-role-allocation" name="04 Agent 角色与任务分配">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="role-title" value="&lt;b&gt;Heavy Task：Agent 角色与任务分配&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;同一种 Agent CLI 可以承担多个角色，但必须使用不同 invocation、上下文、权限与输出契约&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1540" height="60" as="geometry" />
        </mxCell>
        <mxCell id="role-principle" value="&lt;b&gt;角色隔离的目的不是制造更多名字，而是阻止同一个上下文同时“定标准 → 写实现 → 选择测试 → 宣布通过”。&lt;/b&gt;　紫色 = Agent 角色　蓝色 = Spec-Loop 确定性操作　黄色 = 人的授权/验收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f0ff;strokeColor=#9673a6;fontSize=15;spacing=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1540" height="68" as="geometry" />
        </mxCell>

        <mxCell id="current-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#b3b3b3;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="1540" height="285" as="geometry" />
        </mxCell>
        <mxCell id="current-head" value="&lt;b&gt;当前 Phase 3 的真实分配&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Maker 已由 Harness 独立调用；Verifier 依赖主控手工启动独立会话；Analyst / Planner 仍由 Controller 兼任&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="70" y="205" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="current-controller" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;CONTROLLER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;主控对话会话&lt;/b&gt;&lt;br&gt;当前兼任 Spec Analyst、Planner、Gate Planner、Triage 和用户沟通&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;问题：职责过多，容易把自己的计划当成正确答案&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="275" width="440" height="145" as="geometry" />
        </mxCell>
        <mxCell id="current-maker" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;MAKER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Harness 启动的隔离 invocation&lt;/b&gt;&lt;br&gt;只在 worktree 实现和补测试&lt;br&gt;不能改 AC / Approval / Gate Plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="625" y="275" width="360" height="145" as="geometry" />
        </mxCell>
        <mxCell id="current-verifier" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;VERIFIER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;主控另行启动的新会话&lt;/b&gt;&lt;br&gt;读取当前 Spec / diff / Evidence，输出 PASS / FAIL&lt;br&gt;&lt;font color=&quot;#b45f06&quot;&gt;当前缺口：Spec-Loop 尚未自动调度和证明上下文隔离&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1090" y="275" width="410" height="145" as="geometry" />
        </mxCell>
        <mxCell id="current-edge-1" value="派发批准步骤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="current-controller" target="current-maker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="current-edge-2" value="手工启动独立检查" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="current-maker" target="current-verifier"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="target-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f5ff;strokeColor=#9673a6;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="40" y="505" width="1540" height="525" as="geometry" />
        </mxCell>
        <mxCell id="target-head" value="&lt;b&gt;建议的 Heavy 目标态：六个 Agent 角色 + 一个确定性 Gate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Controller 只编排；各角色用结构化产物交接，不传递前一角色的自由结论&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="70" y="520" width="1100" height="50" as="geometry" />
        </mxCell>

        <mxCell id="target-controller" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;CONTROLLER AGENT · 编排者&lt;/b&gt;&lt;/font&gt;&lt;br&gt;选择下一角色、传递最小上下文、处理失败分类与 needs_user&lt;br&gt;&lt;b&gt;禁止：&lt;/b&gt;在同一 Heavy 候选中兼任 Maker 或 Verifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="510" y="585" width="620" height="90" as="geometry" />
        </mxCell>

        <mxCell id="target-analyst" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;1 · SPEC ANALYST&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;分配：定义问题和边界&lt;/b&gt;&lt;br&gt;输入：用户目标 / 现有规格&lt;br&gt;输出：Context、Spec、AC&lt;br&gt;禁止：写实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="720" width="220" height="155" as="geometry" />
        </mxCell>
        <mxCell id="target-planner" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;2 · PLANNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;分配：拆步骤和验证计划&lt;/b&gt;&lt;br&gt;输入：冻结 AC / 工程结构&lt;br&gt;输出：Plan、风险、Gate Plan&lt;br&gt;禁止：降低 AC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="325" y="720" width="220" height="155" as="geometry" />
        </mxCell>
        <mxCell id="target-plan-reviewer" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;3 · PLAN REVIEWER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;分配：对抗性审查计划&lt;/b&gt;&lt;br&gt;新上下文只读 AC / Plan&lt;br&gt;输出：approve / revise + 缺口&lt;br&gt;禁止：直接改计划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="580" y="720" width="220" height="155" as="geometry" />
        </mxCell>
        <mxCell id="target-maker" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;4 · MAKER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;分配：实现和修复&lt;/b&gt;&lt;br&gt;隔离 worktree / 可写代码&lt;br&gt;输出：diff、测试、实现说明&lt;br&gt;禁止：选 Gate、签 PASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="835" y="720" width="220" height="155" as="geometry" />
        </mxCell>
        <mxCell id="target-gate" value="&lt;font color=&quot;#2f5597&quot;&gt;&lt;b&gt;5 · SPEC-LOOP GATE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;分配：确定性执行&lt;/b&gt;&lt;br&gt;执行已冻结命令 / Playwright&lt;br&gt;输出：exit code、duration、hash&lt;br&gt;&lt;font color=&quot;#2f5597&quot;&gt;不是 Agent，不做语义判断&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontSize=12;spacing=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1090" y="720" width="220" height="155" as="geometry" />
        </mxCell>
        <mxCell id="target-verifier" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;6 · VERIFIER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;分配：独立验收审查&lt;/b&gt;&lt;br&gt;全新只读上下文&lt;br&gt;输入：AC、diff、原子 Evidence&lt;br&gt;禁止：边验边修" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1345" y="720" width="205" height="155" as="geometry" />
        </mxCell>

        <mxCell id="target-edge-1" value="Spec / AC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="target-analyst" target="target-planner"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="target-edge-2" value="Plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="target-planner" target="target-plan-reviewer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="target-edge-3" value="批准步骤" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="target-plan-reviewer" target="target-maker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="target-edge-4" value="候选" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontColor=#2f5597;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="target-maker" target="target-gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="target-edge-5" value="Evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="target-gate" target="target-verifier"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="target-rules" value="&lt;b&gt;必须硬隔离&lt;/b&gt;　Maker ↔ Verifier：不同 invocation、不同上下文、不同权限；Verifier 只读且不能在同一轮修复。　　&lt;b&gt;Heavy 建议隔离&lt;/b&gt;　Planner ↔ Plan Reviewer。　　&lt;b&gt;可以复用&lt;/b&gt;　Controller 负责调度和沟通，但不产出实现 PASS。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=13;spacing=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="105" y="920" width="1440" height="78" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="proposed-heavy-architecture-flow" name="05 历史建议架构与 Heavy Task 流程">
    <mxGraphModel dx="1654" dy="2400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p5-title" value="&lt;b&gt;历史建议方案：角色隔离架构 + Heavy Task 完整流程&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;已由第 6 页 P / M / V / R v2 当前架构取代，仅保留作设计演进对照&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#111111;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5-subtitle" value="三个真实执行者不变：人 / Spec-Loop / Agent CLI；Agent CLI 通过独立 invocation 承担不同身份" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="1300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p5-architecture" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#b3b3b3;arcSize=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="95" width="1610" height="690" as="geometry" />
        </mxCell>
        <mxCell id="p5-architecture-label" value="&lt;b&gt;A. 建议目标架构&lt;/b&gt;　严格三层：人 → Spec-Loop → Agent CLI；所有请求与结果都经过 Spec-Loop" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="45" y="110" width="1300" height="35" as="geometry" />
        </mxCell>

        <mxCell id="p5-human-layer" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d6b656;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="90" y="150" width="1475" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p5-human" value="&lt;font color=&quot;#9a6700&quot;&gt;&lt;b&gt;LAYER 1 · 人 HUMAN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;目标、风险偏好、授权、最终验收&lt;/b&gt;&lt;br&gt;只做人类必须做的主观决策；不直接调度任何 Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4ce;strokeColor=#d6b656;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="535" y="165" width="585" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p5-human-controller" value="目标 / 授权 / 验收" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontColor=#2f5597;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-human" target="p5-control-plane"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p5-control-plane" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="90" y="300" width="1475" height="225" as="geometry" />
        </mxCell>
        <mxCell id="p5-control-plane-title" value="&lt;b&gt;LAYER 2 · SPEC-LOOP CONTROL PLANE&lt;/b&gt;　唯一流程控制者与状态事实源；确定性控制面，不是 Agent" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontColor=#2f5597;" vertex="1" parent="1">
          <mxGeometry x="360" y="315" width="930" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p5-state-machine" value="&lt;b&gt;Task State Machine&lt;/b&gt;&lt;br&gt;task / round / revision&lt;br&gt;状态迁移、预算与 Guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="130" y="375" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="p5-dispatcher" value="&lt;b&gt;Role Dispatcher&lt;/b&gt;&lt;br&gt;按身份创建独立 invocation&lt;br&gt;绑定输入、权限、上下文与输出 Schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="475" y="375" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="p5-gate-engine" value="&lt;b&gt;Gate Engine&lt;/b&gt;&lt;br&gt;构建 / 测试 / Playwright / timeout&lt;br&gt;输出 duration、exit code、hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="820" y="375" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="p5-evidence-ledger" value="&lt;b&gt;Evidence Ledger + Delivery Guard&lt;/b&gt;&lt;br&gt;原子证据、角色结论、审计链&lt;br&gt;只有完整链路才能 delivered" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="1165" y="375" width="350" height="110" as="geometry" /></mxCell>
        <mxCell id="p5-controller-dispatcher" value="状态查询 / 调度建议" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-controller" target="p5-dispatcher"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-cp-edge-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="p5-state-machine" target="p5-dispatcher"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-cp-edge-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="p5-dispatcher" target="p5-gate-engine"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-cp-edge-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="p5-gate-engine" target="p5-evidence-ledger"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p5-role-pool" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#9673a6;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="90" y="560" width="1475" height="185" as="geometry" />
        </mxCell>
        <mxCell id="p5-role-pool-title" value="&lt;b&gt;LAYER 3 · AGENT CLI ROLE POOL&lt;/b&gt;　同一 CLI / 模型可以复用；每个身份必须是独立 invocation，且不能越权修改 Spec-Loop 状态" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#674ea7;" vertex="1" parent="1"><mxGeometry x="300" y="570" width="1050" height="30" as="geometry" /></mxCell>
        <mxCell id="p5-controller" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;CONTROLLER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;解释状态 / 沟通&lt;br&gt;不掌握最终调度权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=7;" vertex="1" parent="1"><mxGeometry x="110" y="620" width="190" height="95" as="geometry" /></mxCell>
        <mxCell id="p5-role-analyst" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;SPEC ANALYST&lt;/b&gt;&lt;/font&gt;&lt;br&gt;定义问题 / AC&lt;br&gt;只读项目" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=7;" vertex="1" parent="1"><mxGeometry x="310" y="620" width="190" height="95" as="geometry" /></mxCell>
        <mxCell id="p5-role-planner" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;PLANNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Plan / Gate Plan&lt;br&gt;只读项目" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=7;" vertex="1" parent="1"><mxGeometry x="510" y="620" width="190" height="95" as="geometry" /></mxCell>
        <mxCell id="p5-role-reviewer" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;PLAN REVIEWER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;独立审查计划&lt;br&gt;只读 / 新上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=7;" vertex="1" parent="1"><mxGeometry x="710" y="620" width="190" height="95" as="geometry" /></mxCell>
        <mxCell id="p5-role-maker" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;MAKER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;实现与修复&lt;br&gt;只写隔离 worktree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=7;" vertex="1" parent="1"><mxGeometry x="910" y="620" width="190" height="95" as="geometry" /></mxCell>
        <mxCell id="p5-role-verifier" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;VERIFIER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;独立验收&lt;br&gt;只读 / 新上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=7;" vertex="1" parent="1"><mxGeometry x="1110" y="620" width="190" height="95" as="geometry" /></mxCell>
        <mxCell id="p5-role-triage" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;TRIAGE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;归因与重规划&lt;br&gt;不能直接修代码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;spacing=7;" vertex="1" parent="1"><mxGeometry x="1310" y="620" width="220" height="95" as="geometry" /></mxCell>
        <mxCell id="p5-dispatch-pool" value="隔离调度" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-dispatcher" target="p5-role-pool"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-boundary-rule" value="&lt;b&gt;唯一合法调用链：Human ⇄ Spec-Loop ⇄ Agent CLI&lt;/b&gt;　Human 不直接调 Agent；Agent 不直接改任务状态或向 Human 宣布完成" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="230" y="748" width="1190" height="28" as="geometry" /></mxCell>

        <mxCell id="p5-flow-title" value="&lt;b&gt;B. 建议 Heavy Task 执行时序&lt;/b&gt;　下方三列只表示责任归属，不表示上下级；架构层级始终是 Human → Spec-Loop → Agent CLI" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="35" y="810" width="1450" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p5-lane-human" value="&lt;b&gt;人&lt;/b&gt;&lt;br&gt;授权与验收" style="swimlane;html=1;horizontal=1;startSize=65;rounded=1;fillColor=#fffaf0;swimlaneFillColor=#fffaf0;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="860" width="300" height="1575" as="geometry" /></mxCell>
        <mxCell id="p5-lane-spec" value="&lt;b&gt;Spec-Loop&lt;/b&gt;&lt;br&gt;状态、调度、Gate、证据" style="swimlane;html=1;horizontal=1;startSize=65;rounded=1;fillColor=#f4f8ff;swimlaneFillColor=#f4f8ff;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="340" y="860" width="540" height="1575" as="geometry" /></mxCell>
        <mxCell id="p5-lane-agent" value="&lt;b&gt;Agent CLI&lt;/b&gt;&lt;br&gt;按角色隔离的 invocation" style="swimlane;html=1;horizontal=1;startSize=65;rounded=1;fillColor=#fbf8fc;swimlaneFillColor=#fbf8fc;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1"><mxGeometry x="900" y="860" width="730" height="1575" as="geometry" /></mxCell>

        <mxCell id="p5-f-human-goal" value="&lt;b&gt;1 · 提交目标 / 风险边界&lt;/b&gt;&lt;br&gt;说明期望结果与不可接受项" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4ce;strokeColor=#d6b656;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="55" y="970" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="p5-f-analyst" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;2 · IDENTITY: SPEC ANALYST AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;目标 → Context / Spec / AC&lt;br&gt;只读项目，不写实现" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;spacing=11;" vertex="1" parent="1"><mxGeometry x="975" y="960" width="580" height="105" as="geometry" /></mxCell>
        <mxCell id="p5-f-freeze-ac" value="&lt;b&gt;3 · Freeze Spec / AC&lt;/b&gt;&lt;br&gt;校验结构，记录 Acceptance hash&lt;br&gt;任何变更必须新 revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontSize=13;spacing=11;" vertex="1" parent="1"><mxGeometry x="420" y="1100" width="380" height="105" as="geometry" /></mxCell>
        <mxCell id="p5-f-human-approve" value="&lt;b&gt;4 · 批准 Spec / AC&lt;/b&gt;&lt;br&gt;确认边界与验收口径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4ce;strokeColor=#d6b656;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="55" y="1110" width="230" height="85" as="geometry" /></mxCell>
        <mxCell id="p5-f-planner" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;5 · IDENTITY: PLANNER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;冻结 AC → Plan / 风险 / Gate Plan&lt;br&gt;不能降低 AC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;spacing=11;" vertex="1" parent="1"><mxGeometry x="975" y="1235" width="580" height="100" as="geometry" /></mxCell>
        <mxCell id="p5-f-plan-reviewer" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;6 · IDENTITY: PLAN REVIEWER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;新只读上下文审查覆盖、风险、缺口&lt;br&gt;输出 APPROVE / REVISE，不直接改计划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;spacing=11;" vertex="1" parent="1"><mxGeometry x="975" y="1365" width="580" height="110" as="geometry" /></mxCell>
        <mxCell id="p5-f-freeze-plan" value="&lt;b&gt;7 · Freeze Plan / Gate Plan&lt;/b&gt;&lt;br&gt;绑定 revision、权限与输出契约&lt;br&gt;生成 Maker 最小上下文包" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontSize=13;spacing=11;" vertex="1" parent="1"><mxGeometry x="420" y="1500" width="380" height="105" as="geometry" /></mxCell>
        <mxCell id="p5-f-maker" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;8 · IDENTITY: MAKER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;独立 invocation + 隔离 worktree&lt;br&gt;实现 / 测试 / 变更说明；不能选 Gate、不能签 PASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;spacing=11;" vertex="1" parent="1"><mxGeometry x="975" y="1500" width="580" height="110" as="geometry" /></mxCell>
        <mxCell id="p5-f-gate" value="&lt;b&gt;9 · SPEC-LOOP GATE&lt;/b&gt;&lt;br&gt;执行冻结命令 / Playwright / 安全检查&lt;br&gt;记录 duration、exit code、artifact hash&lt;br&gt;&lt;font color=&quot;#2f5597&quot;&gt;不是 Agent，不做主观判断&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontSize=13;spacing=11;" vertex="1" parent="1"><mxGeometry x="420" y="1640" width="380" height="120" as="geometry" /></mxCell>
        <mxCell id="p5-f-verifier" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;10 · IDENTITY: VERIFIER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;全新只读 invocation；只看 AC / diff / 原子 Evidence&lt;br&gt;输出 PASS / FAIL + finding；禁止边验边修" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;spacing=11;" vertex="1" parent="1"><mxGeometry x="975" y="1785" width="580" height="115" as="geometry" /></mxCell>
        <mxCell id="p5-f-triage" value="&lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;FAIL · IDENTITY: TRIAGE AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;区分实现缺陷 / 计划缺陷 / AC 歧义 / 环境故障&lt;br&gt;创建新 revision，路由回 Planner 或 Maker；不能直接修代码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;spacing=11;" vertex="1" parent="1"><mxGeometry x="975" y="1940" width="580" height="115" as="geometry" /></mxCell>
        <mxCell id="p5-f-human-accept" value="&lt;b&gt;11 · Human Acceptance&lt;/b&gt;&lt;br&gt;业务结果 / UI 主观验收&lt;br&gt;接受或拒绝当前 revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4ce;strokeColor=#d6b656;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="55" y="1945" width="230" height="105" as="geometry" /></mxCell>
        <mxCell id="p5-f-delivery" value="&lt;b&gt;12 · Delivery Guard + deliver&lt;/b&gt;&lt;br&gt;Gate PASS + Verifier PASS + Human Acceptance 全部绑定当前 revision&lt;br&gt;落库 delivered；merge / push / deploy 仍需单独授权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=11;" vertex="1" parent="1"><mxGeometry x="420" y="2110" width="380" height="120" as="geometry" /></mxCell>
        <mxCell id="p5-f-controller" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;IDENTITY: CONTROLLER AGENT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;贯穿全程解释状态、请求授权、向 Spec-Loop 提交调度建议&lt;br&gt;它属于 Agent CLI 层；没有 Gate / Verifier / Human 证据时无权宣称完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#9673a6;fontSize=13;spacing=11;" vertex="1" parent="1"><mxGeometry x="975" y="2290" width="580" height="100" as="geometry" /></mxCell>

        <mxCell id="p5-flow-e1" value="目标" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-f-human-goal" target="p5-f-analyst"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-flow-e2" value="Spec / AC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontColor=#2f5597;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-f-analyst" target="p5-f-freeze-ac"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-flow-e3" value="请求批准" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontColor=#9a6700;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-f-freeze-ac" target="p5-f-human-approve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-flow-e4" value="批准" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-f-human-approve" target="p5-f-planner"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-flow-e5" value="Plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-f-planner" target="p5-f-plan-reviewer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-flow-e6" value="APPROVE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontColor=#2f5597;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-f-plan-reviewer" target="p5-f-freeze-plan"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-flow-e7" value="最小上下文包" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-f-freeze-plan" target="p5-f-maker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-flow-e8" value="diff / tests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontColor=#2f5597;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-f-maker" target="p5-f-gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-flow-e9" value="Gate PASS + Evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-f-gate" target="p5-f-verifier"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-flow-e10" value="Verifier PASS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontColor=#9a6700;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-f-verifier" target="p5-f-human-accept"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-flow-e11" value="接受" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontColor=#2d7600;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-f-human-accept" target="p5-f-delivery"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p5-flow-fail-gate" value="Gate FAIL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="p5-f-gate" target="p5-f-triage"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-flow-fail-verifier" value="Verifier FAIL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5-f-verifier" target="p5-f-triage"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-flow-revise-plan" value="计划 / AC 问题 → 新 revision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=1;entryY=0.5;" edge="1" parent="1" source="p5-f-triage" target="p5-f-planner"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1590" y="2000" /><mxPoint x="1590" y="1285" /></Array></mxGeometry></mxCell>
        <mxCell id="p5-flow-revise-maker" value="实现问题 → 新 Maker invocation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="p5-f-triage" target="p5-f-maker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p5-flow-revise-review" value="REVISE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p5-f-plan-reviewer" target="p5-f-planner"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="1420" /><mxPoint x="1580" y="1285" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="pmvr-v2-current" name="06 P-M-V-R v2 当前架构">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="p6-0" />
        <mxCell id="p6-1" parent="p6-0" />

        <mxCell id="p6-title" value="&lt;b&gt;Spec-Loop P / M / V / R v2 当前架构&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;P 预制并冻结验收契约；M 只实现；V 独立验收；R 独立复核；只有双 PASS 才形成 Candidate&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;spacingLeft=4;" vertex="1" parent="p6-1">
          <mxGeometry x="40" y="20" width="1560" height="65" as="geometry" />
        </mxCell>

        <mxCell id="p6-section-a" value="&lt;b&gt;A. 四段职责与事实边界&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#333333;" vertex="1" parent="p6-1">
          <mxGeometry x="45" y="95" width="500" height="35" as="geometry" />
        </mxCell>

        <mxCell id="p6-role-p" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;P · SPEC / ACCEPTANCE PLANNER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;规格库创建时一次准备完整契约&lt;/b&gt;&lt;br&gt;AC · 用例 · 工具/命令 · 断言 · Evidence 要求&lt;br&gt;输出 contract hash；由人批准后冻结" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#9673a6;fontSize=13;spacing=11;align=left;verticalAlign=middle;" vertex="1" parent="p6-1">
          <mxGeometry x="45" y="140" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p6-role-m" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;M · MAKER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;唯一可写候选 Worktree 的角色&lt;/b&gt;&lt;br&gt;实现 + 自测 → 干净、稳定、新 HEAD&lt;br&gt;返工必须产生新 HEAD；不能改契约或签 PASS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#9673a6;fontSize=13;spacing=11;align=left;verticalAlign=middle;" vertex="1" parent="p6-1">
          <mxGeometry x="430" y="140" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p6-role-v" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;V · INDEPENDENT VERIFIER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;新的只读 invocation&lt;/b&gt;&lt;br&gt;按计划运行 Playwright / API / 单测 / Gate&lt;br&gt;结果绑定 Contract + Plan + HEAD + Evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#9673a6;fontSize=13;spacing=11;align=left;verticalAlign=middle;" vertex="1" parent="p6-1">
          <mxGeometry x="815" y="140" width="350" height="145" as="geometry" />
        </mxCell>
        <mxCell id="p6-role-r" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;R · INDEPENDENT REVIEWER&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;仅在 V PASS 后启动的另一 invocation&lt;/b&gt;&lt;br&gt;复核 V 结论、AC 覆盖和 Evidence hash 链&lt;br&gt;不替 V 跑测试；不能修改实现或 V Evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5eef8;strokeColor=#9673a6;fontSize=13;spacing=11;align=left;verticalAlign=middle;" vertex="1" parent="p6-1">
          <mxGeometry x="1200" y="140" width="350" height="145" as="geometry" />
        </mxCell>

        <mxCell id="p6-engine" value="&lt;b&gt;Spec-Loop Controller / Policy Engine&lt;/b&gt;&lt;br&gt;编译执行计划 · 校验角色/HEAD/Evidence 新鲜度 · 分类路由 · 预算/指纹熔断 · 调度依赖&lt;br&gt;&lt;font color=&quot;#2f5597&quot;&gt;确定性状态迁移；不写代码、不代替 V/R 作语义结论&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="p6-1">
          <mxGeometry x="230" y="330" width="1090" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p6-human" value="&lt;b&gt;Human Authority&lt;/b&gt;&lt;br&gt;批准 Contract&lt;br&gt;处理规格/高风险/预算冲突&lt;br&gt;改规格并重新授权 · 换方案 · 拆分 · 非关键豁免 · 外部阻塞 · 取消" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="p6-1">
          <mxGeometry x="1350" y="320" width="250" height="125" as="geometry" />
        </mxCell>

        <mxCell id="p6-contract-store" value="&lt;b&gt;ACCEPTANCE_CONTRACT_V2.md&lt;/b&gt;&lt;br&gt;Proposal Approval 绑定完整契约与版本" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="45" y="485" width="330" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p6-worktree-store" value="&lt;b&gt;Task Worktree / Git&lt;/b&gt;&lt;br&gt;base · HEAD · diff hash · tree fingerprint&lt;br&gt;M 写；V / R 只读" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="430" y="485" width="330" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p6-run-store" value="&lt;b&gt;ACCEPTANCE_RUN / EXECUTION_PLAN&lt;/b&gt;&lt;br&gt;Contract · HEAD · diff · Gate · toolchain · environment&lt;br&gt;v1 TASK_STATE 不自动迁移" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="815" y="485" width="350" height="105" as="geometry" />
        </mxCell>
        <mxCell id="p6-evidence-store" value="&lt;b&gt;V / R Evidence + Candidate&lt;/b&gt;&lt;br&gt;独立目录 · 内容 hash · invocation · 当前 HEAD&lt;br&gt;Conflict 是权威事实；Inbox 可重建" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=8;" vertex="1" parent="p6-1">
          <mxGeometry x="1200" y="485" width="350" height="105" as="geometry" />
        </mxCell>

        <mxCell id="p6-a-e1" value="批准后" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-role-p" target="p6-role-m"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p6-a-e2" value="稳定 HEAD + 计划" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-role-m" target="p6-role-v"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p6-a-e3" value="V PASS + Evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-role-v" target="p6-role-r"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p6-a-e4" value="批准 / 冲突决策" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontColor=#9a6700;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-human" target="p6-engine"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="p6-compat" value="&lt;b&gt;升级兼容边界&lt;/b&gt;　v2 仅显式 opt-in；正在运行的 TASK-027 / TASK-028 等 v1 Task 保持原 TASK_STATE / VERIFY 协议，不迁移、不重启。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="p6-1">
          <mxGeometry x="180" y="625" width="1290" height="65" as="geometry" />
        </mxCell>

        <mxCell id="p6-section-b" value="&lt;b&gt;B. Heavy Task 完整时序与失败路由&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;实线是主成功链；红色虚线是返工/人工路由；M/V/R 共享初次执行后最多 2 次语义返工&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#333333;" vertex="1" parent="p6-1">
          <mxGeometry x="45" y="725" width="1500" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p6-lane-human" value="&lt;b&gt;Human&lt;/b&gt;&lt;br&gt;批准与冲突决策" style="swimlane;html=1;horizontal=1;startSize=65;rounded=1;fillColor=#fff9e6;swimlaneFillColor=#fff9e6;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="p6-1">
          <mxGeometry x="45" y="800" width="290" height="1270" as="geometry" />
        </mxCell>
        <mxCell id="p6-lane-engine" value="&lt;b&gt;Spec-Loop&lt;/b&gt;&lt;br&gt;状态 · 计划 · 预算 · Evidence · 调度" style="swimlane;html=1;horizontal=1;startSize=65;rounded=1;fillColor=#f4f8ff;swimlaneFillColor=#f4f8ff;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="p6-1">
          <mxGeometry x="365" y="800" width="700" height="1270" as="geometry" />
        </mxCell>
        <mxCell id="p6-lane-agent" value="&lt;b&gt;Agent CLI invocations&lt;/b&gt;&lt;br&gt;P / M / V / R 物理隔离" style="swimlane;html=1;horizontal=1;startSize=65;rounded=1;fillColor=#faf7fc;swimlaneFillColor=#faf7fc;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="p6-1">
          <mxGeometry x="1095" y="800" width="505" height="1270" as="geometry" />
        </mxCell>

        <mxCell id="p6-f-goal" value="&lt;b&gt;1 · 提出目标 / 风险 / 不可接受项&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;spacing=10;" vertex="1" parent="p6-1"><mxGeometry x="75" y="895" width="230" height="75" as="geometry" /></mxCell>
        <mxCell id="p6-f-p" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;2 · P invocation&lt;/b&gt;&lt;/font&gt;&lt;br&gt;同步生成 Spec / Task / AC / 用例 / 工具 / 断言 / Evidence 要求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;spacing=10;" vertex="1" parent="p6-1"><mxGeometry x="1150" y="875" width="390" height="105" as="geometry" /></mxCell>
        <mxCell id="p6-f-freeze" value="&lt;b&gt;3 · Freeze Acceptance Contract&lt;/b&gt;&lt;br&gt;规范化内容 → contract hash&lt;br&gt;Proposal 同时绑定完整契约" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontSize=13;spacing=10;" vertex="1" parent="p6-1"><mxGeometry x="500" y="1005" width="420" height="100" as="geometry" /></mxCell>
        <mxCell id="p6-f-approve" value="&lt;b&gt;4 · 人批准精确 Contract hash&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;spacing=10;" vertex="1" parent="p6-1"><mxGeometry x="75" y="1020" width="230" height="75" as="geometry" /></mxCell>
        <mxCell id="p6-f-m" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;5 · M invocation&lt;/b&gt;&lt;/font&gt;&lt;br&gt;隔离 Worktree 实现 + 自测&lt;br&gt;提交干净稳定 HEAD；返工必须是新 HEAD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;spacing=10;" vertex="1" parent="p6-1"><mxGeometry x="1150" y="1135" width="390" height="105" as="geometry" /></mxCell>
        <mxCell id="p6-f-submit" value="&lt;b&gt;6 · M Candidate Guard&lt;/b&gt;&lt;br&gt;HEAD · base · diff hash · tree fingerprint · self-test Evidence&lt;br&gt;依赖未 Candidate / delivered 则拒绝提交" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontSize=13;spacing=10;" vertex="1" parent="p6-1"><mxGeometry x="500" y="1135" width="420" height="105" as="geometry" /></mxCell>
        <mxCell id="p6-f-compile" value="&lt;b&gt;7 · Compile Execution Plan&lt;/b&gt;&lt;br&gt;Contract + HEAD + diff + Gate + toolchain + environment&lt;br&gt;逐 AC 映射用例 / 工具 / 断言 / Evidence；禁止缩减语义" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2f8;strokeColor=#6c8ebf;fontSize=13;spacing=10;" vertex="1" parent="p6-1"><mxGeometry x="500" y="1275" width="420" height="115" as="geometry" /></mxCell>
        <mxCell id="p6-f-v" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;8 · V invocation&lt;/b&gt;&lt;/font&gt;&lt;br&gt;只读候选；执行受控 Gate / Playwright / API / 单测&lt;br&gt;输出绑定当前 Plan / HEAD 的新 Evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;spacing=10;" vertex="1" parent="p6-1"><mxGeometry x="1150" y="1425" width="390" height="110" as="geometry" /></mxCell>
        <mxCell id="p6-f-v-route" value="&lt;b&gt;9 · V Verdict Router&lt;/b&gt;&lt;br&gt;PASS → R&lt;br&gt;实现问题 → M　｜　工具/环境 → 单独有界重试&lt;br&gt;规格歧义 / 高风险 → Human" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;spacing=7;" vertex="1" parent="p6-1"><mxGeometry x="535" y="1420" width="350" height="130" as="geometry" /></mxCell>
        <mxCell id="p6-f-r" value="&lt;font color=&quot;#722ed1&quot;&gt;&lt;b&gt;10 · R invocation&lt;/b&gt;&lt;/font&gt;&lt;br&gt;不同于 V 的只读会话&lt;br&gt;复核 V 结论、全部 AC 覆盖、Evidence 内容 hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;spacing=10;" vertex="1" parent="p6-1"><mxGeometry x="1150" y="1585" width="390" height="105" as="geometry" /></mxCell>
        <mxCell id="p6-f-r-route" value="&lt;b&gt;11 · R Verdict Router&lt;/b&gt;&lt;br&gt;PASS → Evidence Gate&lt;br&gt;实现问题 → M　｜　Evidence 问题 → V&lt;br&gt;规格问题 → Human" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;spacing=7;" vertex="1" parent="p6-1"><mxGeometry x="535" y="1580" width="350" height="125" as="geometry" /></mxCell>
        <mxCell id="p6-f-candidate" value="&lt;b&gt;12 · Evidence Gate → Candidate&lt;/b&gt;&lt;br&gt;V PASS + R PASS + 当前 Contract / Plan / HEAD&lt;br&gt;V/R Evidence 未篡改且覆盖全部 AC&lt;br&gt;&lt;font color=&quot;#2d7600&quot;&gt;Candidate 不是自动 merge / push / deploy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;spacing=10;" vertex="1" parent="p6-1"><mxGeometry x="500" y="1745" width="420" height="120" as="geometry" /></mxCell>
        <mxCell id="p6-f-conflict" value="&lt;b&gt;waiting_human_review&lt;/b&gt;&lt;br&gt;预算耗尽 / 重复失败指纹 / 规格或高风险冲突&lt;br&gt;生成权威 Conflict Record + 可重建 Review Inbox&lt;br&gt;普通独立 Task 暂挂；下游继续 blocked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=9;" vertex="1" parent="p6-1"><mxGeometry x="500" y="1900" width="420" height="125" as="geometry" /></mxCell>
        <mxCell id="p6-f-human-resolve" value="&lt;b&gt;人工处理冲突&lt;/b&gt;&lt;br&gt;Heavy / 高风险 / 关键路径立即介入&lt;br&gt;改规格并重新授权预算 · 换方案 · 拆分 Task&lt;br&gt;非关键豁免 · 外部阻塞 · 取消" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;spacing=9;" vertex="1" parent="p6-1"><mxGeometry x="65" y="1895" width="250" height="135" as="geometry" /></mxCell>

        <mxCell id="p6-budget" value="&lt;b&gt;统一预算规则&lt;/b&gt;　初次 M / V / R 不计返工；语义返工最多 2 次。M 重试必须新 HEAD；V / R 重试必须新 Evidence 内容。基础设施重试独立计数；同失败指纹可提前熔断。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=13;spacing=11;align=center;verticalAlign=middle;" vertex="1" parent="p6-1"><mxGeometry x="205" y="2110" width="1240" height="70" as="geometry" /></mxCell>

        <mxCell id="p6-f-e1" value="目标" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#674ea7;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-f-goal" target="p6-f-p"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p6-f-e2" value="完整契约" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontColor=#2f5597;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-f-p" target="p6-f-freeze"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p6-f-e3" value="请求批准" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontColor=#9a6700;labelBackgroundColor=#ffffff;" edge="1" parent="p6-1" source="p6-f-freeze" target="p6-f-approve"><mxGeometry relative="1" as="geometry" /></mxCell>
