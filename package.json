{
  "name": "spec-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "assets/target-spec"
  ],
  "bin": {
    "spec-loop": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "check:feishu-contracts": "node tools/check-feishu-connector-contracts.mjs",
    "quality:standard": "npm run build && npm run check:feishu-contracts && node --test test/*.test.mjs",
    "test": "npm run quality:standard",
    "check": "npm run build && node dist/cli.js --help"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "commander": "^14.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
