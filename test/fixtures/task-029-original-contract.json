{
  "schema_version": 2,
  "task_id": "TASK-029",
  "version": 1,
  "risk": "heavy",
  "critical_path": true,
  "depends_on": [
    "TASK-027",
    "TASK-028"
  ],
  "criteria": [
    {
      "id": "AC-1",
      "text": "当前仓库和至少一个历史 Dogfood Project 在删除 cache 后均可重建；已知 Gate 时长精确，旧状态/Attempt 缺失时长明确显示 unknown。",
      "risk_tags": [
        "data_integrity"
      ],
      "waivable": false
    },
    {
      "id": "AC-2",
      "text": "200×200 fixture 冷重建不超过 2 秒，追加单事件后的增量投影和页面可见时间不超过 500 毫秒。",
      "risk_tags": [
        "functional"
      ],
      "waivable": false
    },
    {
      "id": "AC-3",
      "text": "事件损坏、事实冲突、非法路径、XSS 和 Secret canary 全部 fail closed 或安全降级，无误导性绿色结论。",
      "risk_tags": [
        "security"
      ],
      "waivable": false
    },
    {
      "id": "AC-4",
      "text": "桌面与窄屏四条核心浏览器路径全部通过，用户完成当前 revision 的视觉 Review 和 Heavy 人工确认。",
      "risk_tags": [
        "functional"
      ],
      "waivable": false
    },
    {
      "id": "AC-5",
      "text": "删除 UI cache/snapshot 不影响 Task、Harness、Evidence、Review 或 Delivery，重建后的 canonical snapshot 等价。",
      "risk_tags": [
        "data_integrity"
      ],
      "waivable": false
    },
    {
      "id": "AC-6",
      "text": "Phase 1–3 全量回归与 FEAT-009 全部 Gate 在最终候选通过；独立 V 确认可重建性和事实源边界，独立 R 复核 AC 覆盖与 Evidence 链，双 PASS 后才形成 Candidate。",
      "risk_tags": [
        "critical_path"
      ],
      "waivable": false
    },
    {
      "id": "AC-7",
      "text": "交互终端启动 Task/批次/Harness 时 5 秒内复用或启动唯一 Project view、打印并默认打开 URL；重复启动、僵尸 marker、端口冲突、CI、`--no-view` 和浏览器不可用路径均确定且不阻断任务。",
      "risk_tags": [
        "functional"
      ],
      "waivable": false
    },
    {
      "id": "AC-8",
      "text": "顶部当前工作优先来自最新未闭合执行步骤；多个 Task 并发时全部可见，旧 working 状态或较新的 Task State 时间不得覆盖实际运行中的 Harness/活动步骤。",
      "risk_tags": [
        "data_integrity"
      ],
      "waivable": false
    }
  ],
  "use_cases": [
    {
      "id": "UC-1",
      "ac": [
        "AC-1"
      ],
      "scenario": "Self-hosted and historical projects rebuild after cache deletion with exact or unknown timing shown honestly"
    },
    {
      "id": "UC-2",
      "ac": [
        "AC-2"
      ],
      "scenario": "A 200 Task by 200 event fixture meets the 2 second cold and 500 millisecond incremental and HTTP visibility limits"
    },
    {
      "id": "UC-3",
      "ac": [
        "AC-3"
      ],
      "scenario": "Corrupt events, invalid paths, XSS and Secret canaries fail closed or degrade safely without false green results"
    },
    {
      "id": "UC-4",
      "ac": [
        "AC-4"
      ],
      "scenario": "Four desktop and narrow browser paths pass and current revision visual and Heavy decisions are recorded"
    },
    {
      "id": "UC-5",
      "ac": [
        "AC-5"
      ],
      "scenario": "Deleting disposable UI cache preserves Task, Harness, Evidence, Review and Delivery facts and canonical snapshot"
    },
    {
      "id": "UC-6",
      "ac": [
        "AC-6"
      ],
      "scenario": "Phase 1 to 3 regression and FEAT-009 gates pass with independent V and R on the final candidate"
    },
    {
      "id": "UC-7",
      "ac": [
        "AC-7"
      ],
      "scenario": "Interactive Task, wave and Harness startup opens or reuses one view within 5 seconds and failure paths never block Task"
    },
    {
      "id": "UC-8",
      "ac": [
        "AC-8"
      ],
      "scenario": "The latest open execution step remains current and concurrent Tasks stay visible despite newer stale Task State"
    }
  ],
